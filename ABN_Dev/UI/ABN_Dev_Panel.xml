<?xml version="1.0" encoding="utf-8"?>
<!-- ABN_Dev_Panel: dev tools panel for Abandon Cities (UI context, AddUserInterfaces InGame).
     Toggle: Ctrl+Shift+D or the "DEV" launch bar button. InGame.lua loads this context HIDDEN;
     the Lua un-hides ContextPtr in Initialize and toggles only the Main container.
     Layout copied from EFV_Dev_Panel.xml (spike build 0.0.0.1 of this mod). -->
<Context Name="ABN_Dev_Panel">

	<Container ID="Main" Anchor="L,T" Offset="12,64" Size="744,840" Hidden="1" ConsumeMouse="1">
		<Box Anchor="L,T" Size="parent,parent" Color="12,16,24,235"/>
		<Box Anchor="L,T" Size="parent,2" Color="200,170,110,255"/>
		<Box Anchor="L,B" Size="parent,2" Color="200,170,110,255"/>
		<Stack ID="MainStack" Anchor="L,T" Offset="10,8" StackGrowth="Bottom" StackPadding="4">
			<Container Size="724,28">
				<Label ID="TitleLabel" Anchor="L,C" Style="FontNormal18" Color="240,220,170,255" String="Abandon Cities dev tools"/>
				<GridButton ID="RefreshButton" Anchor="R,C" Offset="76,0" Size="70,26" SliceCorner="12,12" SliceSize="1,1" SliceTextureSize="24,24" Texture="Controls_ButtonControl_Brown" StateOffsetIncrement="0,24" Style="FontNormal14" TextColor="230,220,200,255" String="Refresh"/>
				<GridButton ID="CloseButton" Anchor="R,C" Size="70,26" SliceCorner="12,12" SliceSize="1,1" SliceTextureSize="24,24" Texture="Controls_ButtonControl_Brown" StateOffsetIncrement="0,24" Style="FontNormal14" TextColor="230,220,200,255" String="Close"/>
			</Container>
			<Label ID="InfoLabel" Anchor="L,T" Style="FontNormal12" Color="210,210,210,255" WrapWidth="724" String="-"/>
			<Stack ID="ButtonStack" Anchor="L,T" StackGrowth="Right" WrapWidth="724" StackPadding="4"/>
			<ScrollPanel ID="ResultScroll" Anchor="L,T" Size="724,380" Vertical="1" AutoScrollBar="1">
				<Stack ID="ResultStack" Anchor="L,T" StackGrowth="Bottom" StackPadding="6">
					<Label ID="ResultLabel" Anchor="L,T" Style="FontNormal12" Color="240,220,170,255" WrapWidth="704" String="-"/>
					<Label ID="UILabel" Anchor="L,T" Style="FontNormal12" Color="190,220,240,255" WrapWidth="704" String="-"/>
				</Stack>
				<ScrollBar Style="ScrollVerticalBarAlt" Anchor="R,C" AnchorSide="O,I"/>
			</ScrollPanel>
		</Stack>
	</Container>

	<Instance Name="DevButtonInstance">
		<GridButton ID="Button" Size="140,26" SliceCorner="12,12" SliceSize="1,1" SliceTextureSize="24,24" Texture="Controls_ButtonControl_Brown" StateOffsetIncrement="0,24" Style="FontNormal12" TextColor="230,220,200,255" String=""/>
	</Instance>

	<Instance Name="DevHeaderInstance">
		<Container ID="Header" Size="724,22">
			<Label ID="HeaderLabel" Anchor="L,B" Style="FontNormal14" Color="240,220,170,255" String=""/>
		</Container>
	</Instance>

	<Instance Name="DevLaunchBarItem">
		<Button ID="LaunchItemButton" Anchor="L,C" Size="49,49" Texture="LaunchBar_Hook_GreatPeopleButton" Style="ButtonNormalText" TextureOffset="0,-1" StateOffsetIncrement="0,49" ToolTip="Abandon Cities dev panel (Ctrl+Shift+D)">
			<Label Anchor="C,C" Offset="0,1" Style="FontNormal14" Color="240,220,170,255" String="DEV"/>
		</Button>
	</Instance>
	<Instance Name="DevLaunchBarPinInstance">
		<Image ID="Pin" Anchor="L,C" Offset="0,-2" Size="7,7" Texture="LaunchBar_TrackPip" Color="255,255,255,200"/>
	</Instance>

</Context>
